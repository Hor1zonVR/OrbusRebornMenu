<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OrbusRebornMenu</AssemblyName>
    <RootNamespace>OrbusRebornMenu</RootNamespace>
    <GameDir Condition="'$(GameDir)' == ''">$(LOCALAPPDATA)\OrbusRebornModdingInstances\My Orbus Renewed</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(GameDir)\BepInEx\core\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameDir)\BepInEx\interop\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputModule"><HintPath>$(GameDir)\BepInEx\interop\UnityEngine.InputModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(GameDir)\BepInEx\interop\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.VRModule" Condition="Exists('$(GameDir)\BepInEx\interop\UnityEngine.VRModule.dll')"><HintPath>$(GameDir)\BepInEx\interop\UnityEngine.VRModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.XRModule" Condition="Exists('$(GameDir)\BepInEx\interop\UnityEngine.XRModule.dll')"><HintPath>$(GameDir)\BepInEx\interop\UnityEngine.XRModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="ValidateReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameDir)\BepInEx\core\BepInEx.Core.dll')" Text="Missing BepInEx. Pass -p:GameDir=YOUR_MODDED_GAME_FOLDER." />
    <Error Condition="!Exists('$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll')" Text="Missing BepInEx IL2CPP core." />
    <Error Condition="!Exists('$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll')" Text="Run the selected BepInEx game once to generate IL2CPP interop." />
    <Error Condition="!Exists('$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll')" Text="Unity CoreModule generated interop is missing." />
    <Error Condition="!Exists('$(GameDir)\BepInEx\interop\UnityEngine.TextRenderingModule.dll')" Text="Unity TextRenderingModule generated interop is missing." />
    <Error Condition="!Exists('$(GameDir)\BepInEx\interop\UnityEngine.InputModule.dll')" Text="Unity InputModule generated interop is missing." />
    <Error Condition="!Exists('$(GameDir)\BepInEx\interop\UnityEngine.PhysicsModule.dll')" Text="Unity PhysicsModule generated interop is missing." />
    <Error Condition="!Exists('$(GameDir)\BepInEx\interop\UnityEngine.VRModule.dll') and !Exists('$(GameDir)\BepInEx\interop\UnityEngine.XRModule.dll')" Text="Unity VR / XR generated interop is missing." />
  </Target>
</Project>
